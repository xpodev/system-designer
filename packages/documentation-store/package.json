    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@systemathic/documentation": "workspace:*",
    "@systemathic/editing": "workspace:*",
    "@systemathic/editors": "workspace:*",
    "@systemathic/tool": "workspace:*"
  },
  "devDependencies": {
    "@systemathic/tool-json": "workspace:*"
  }
}
