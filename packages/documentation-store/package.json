{
  "name": "@systemathic/documentation-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Documentation Store: Documentation's Metadata Provider and Edit Kind, describing things on the System's History.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
