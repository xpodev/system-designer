{
  "name": "@systemathic/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hosting: where system contexts live \u2014 one authority per system context, on whatever files, catalog and script host it is given.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@systemathic/catalog": "workspace:*",
    "@systemathic/configurations": "workspace:*",
    "@systemathic/core": "workspace:*",
    "@systemathic/diagnoser": "workspace:*",
    "@systemathic/documentation-store": "workspace:*",
    "@systemathic/editing": "workspace:*",
    "@systemathic/editors": "workspace:*",
    "@systemathic/exporter": "workspace:*",
    "@systemathic/perspectives": "workspace:*",
    "@systemathic/tool": "workspace:*",
    "@systemathic/tool-json": "workspace:*",
    "@systemathic/verifier": "workspace:*"
  }
}
