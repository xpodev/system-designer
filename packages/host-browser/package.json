{
  "name": "@systemathic/host-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hosting in a browser tab: Systems kept in the browser, the catalog bundled, and rules run by Python in WebAssembly.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@systemathic/catalog": "workspace:*",
    "@systemathic/host": "workspace:*",
    "@systemathic/pyodide-host": "workspace:*",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "vite": "^8.3.2"
  }
}
